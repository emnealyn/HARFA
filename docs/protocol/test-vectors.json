{
  "protocol": "2.0",
  "spec": "docs/protocol/ble-protocol.md",
  "format": {
    "hex": "Bajty ramki jako wielkie cyfry szesnastkowe oddzielone pojedynczymi spacjami. Pusty napis oznacza ramkę o długości 0.",
    "direction": "app_to_harp lub harp_to_app. Informacyjnie: kodeki są symetryczne i każda implementacja testuje wszystkie wektory.",
    "valid": "true: decode(hex) MUSI zwrócić obiekt równy decoded. false: decode(hex) MUSI zwrócić błąd z pola error.",
    "roundtrip": "Tylko dla valid = true. true: dodatkowo encode(decoded) MUSI zwrócić dokładnie hex. false: ramka zawiera nadmiarowe bajty lub zarezerwowane bity, które dekoder pomija.",
    "decoded": "Pola nagłówka (ver, type, seq, sid) oraz pola payloadu o nazwach ze specyfikacji. type jako nazwa wiadomości, pozostałe wartości jako liczby dziesiętne. CONFIG_STATE w wartościach logicznych (-1, 0, +1), bez offsetu +1. Zarezerwowane bity w caps, flags i what są wyzerowane.",
    "spec_ref": "Sekcja specyfikacji, z której pochodzi wektor."
  },
